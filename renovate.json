{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "configMigration": true,
  "pruneStaleBranches": true,
  "branchConcurrentLimit": 0,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": [
    "deps"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "/^[Rr]enovatebot/github-action/"
      ],
      "automerge": true
    }
  ]
}
