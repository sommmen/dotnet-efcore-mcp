<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetEfCoreMcp.Server\DotnetEfCoreMcp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixture project is intentionally NOT a ProjectReference: tests load its built DLL at
         runtime via the same AssemblyLoadContext code path the server uses for real target
         projects, so we only need its build output, not a compile-time reference. A pre-build
         target below ensures it is built before the test assembly runs. -->
    <None Include="..\Fixtures\SampleApp\SampleApp.csproj" />
    <None Include="..\Fixtures\NoContextApp\NoContextApp.csproj" />
    <None Include="..\Fixtures\BrokenDependencyApp\BrokenDependencyApp.csproj" />
    <None Include="..\Fixtures\BrokenDependencyApp.Dependency\BrokenDependencyApp.Dependency.csproj" />
    <None Include="..\Fixtures\PackageDependencyApp\PackageDependencyApp.csproj" />
  </ItemGroup>

  <Target Name="BuildFixtureAssemblies" BeforeTargets="Build">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\Fixtures\SampleApp\SampleApp.csproj&quot; -c $(Configuration) --nologo -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\Fixtures\NoContextApp\NoContextApp.csproj&quot; -c $(Configuration) --nologo -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\Fixtures\BrokenDependencyApp\BrokenDependencyApp.csproj&quot; -c $(Configuration) --nologo -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\Fixtures\PackageDependencyApp\PackageDependencyApp.csproj&quot; -c $(Configuration) --nologo -v quiet" />
  </Target>

</Project>