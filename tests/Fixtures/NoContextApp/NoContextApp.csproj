<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NoContextApp</RootNamespace>
    <!-- This fixture stands in for "a compiled assembly that loads fine but has no DbContexts" -
         e.g. a shared/utility DLL a user might accidentally point load_assembly at. It intentionally
         has no ProjectReference from the test project; see SampleApp.csproj for the same rationale. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

</Project>
